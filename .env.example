# ==========================================
# ODRISYSTEMS Production Environment Config
# ==========================================

# Database Configuration
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=odri_monitoring_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres_user:your_secure_db_password_here@db:5432/odri_monitoring_db

# Security & JWT Configuration
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
SECRET_KEY=your_secure_random_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Port Binding Configurations
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Frontend API URL Configuration
VITE_API_URL=http://localhost:8001

# SMTP Email Notification Settings
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@mg.odrisystems.io
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=alerts@odrisystems.io
